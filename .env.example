# Database Configuration
QMA_DB_NAME=quantity_measurement
QMA_DB_USER=postgres
QMA_DB_PASSWORD=postgres
QMA_DB_HOST=postgres
QMA_DB_PORT=5432
QMA_DATABASE_URL=jdbc:postgresql://postgres:5432/quantity_measurement
QMA_DATABASE_USERNAME=postgres
QMA_DATABASE_PASSWORD=postgres

# Service Ports
QMA_POSTGRES_HOST_PORT=5432
QMA_POSTGRES_CONTAINER_PORT=5432
QMA_EUREKA_HOST_PORT=8761
QMA_EUREKA_SERVICE_PORT=8761
QMA_MEASUREMENT_HOST_PORT=8081
QMA_MEASUREMENT_SERVICE_PORT=8081
QMA_USER_HOST_PORT=8082
QMA_USER_SERVICE_PORT=8082
QMA_ADMIN_HOST_PORT=9090
QMA_ADMIN_SERVICE_PORT=9090
QMA_GATEWAY_HOST_PORT=8080
QMA_GATEWAY_SERVICE_PORT=8080
QMA_FRONTEND_HOST_PORT=3000
QMA_FRONTEND_CONTAINER_PORT=80

# Docker Image Configuration
QMA_MAVEN_BUILDER_IMAGE=maven:3.9.6-eclipse-temurin-21
QMA_JAVA_RUNTIME_IMAGE=eclipse-temurin:21-jre-noble
QMA_APP_USER_ID=10001

# Service Discovery
QMA_EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka/

# Service Memory Configuration
QMA_EUREKA_JAVA_OPTS=-Xms256m -Xmx512m
QMA_MEASUREMENT_JAVA_OPTS=-Xms512m -Xmx1024m
QMA_USER_JAVA_OPTS=-Xms512m -Xmx1024m
QMA_ADMIN_JAVA_OPTS=-Xms256m -Xmx512m
QMA_GATEWAY_JAVA_OPTS=-Xms512m -Xmx1024m

# Security
QMA_JWT_SECRET=VGhpc0lzQVNlY3VyZVNob3VsZsdjfvdsFzdDMyQ2hhcmFjdGVyc0xvbmdGb3JKV1Q=

# OAuth Configuration (Google)
QMA_GOOGLE_CLIENT_ID=docker-placeholder-google-client-id
QMA_GOOGLE_CLIENT_SECRET=docker-placeholder-google-client-secret
QMA_GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Frontend Configuration
QMA_APP_REDIRECT_URI=http://localhost:3000/oauth-callback
QMA_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# Docker Healthcheck Configuration
QMA_HEALTHCHECK_INTERVAL=10s
QMA_HEALTHCHECK_TIMEOUT=5s
QMA_HEALTHCHECK_RETRIES=5
QMA_POSTGRES_HEALTHCHECK_START_PERIOD=10s
QMA_APP_HEALTHCHECK_START_PERIOD=30s
QMA_FRONTEND_HEALTHCHECK_START_PERIOD=10s

# Docker Network Configuration
QMA_DOCKER_NETWORK_NAME=quantity-microservices-network
QMA_DOCKER_NETWORK_SUBNET=172.28.0.0/16
QMA_POSTGRES_VOLUME_NAME=quantity-postgres-data
